{
  "name": "web-pribadi",
  "version": "1.0.0",
  "private": true,
  "description": "Website pribadi Muhammad Rizal Haris — full-stack (Next.js + Prisma + PostgreSQL).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "sync": "bash scripts/auto-sync.sh",
    "push": "git push origin main"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "eslint-config-next": "^15.5.28",
    "next": "^15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "prisma": "5.22.0",
    "typescript": "5.6.3"
  }
}
