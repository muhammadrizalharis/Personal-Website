# ------------------------------------------------------------------
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env
# JANGAN commit file .env yang berisi kredensial asli.
# ------------------------------------------------------------------

# URL koneksi PostgreSQL.
# - Lokal via docker-compose, dari HOST (mis. prisma studio): gunakan localhost
#   postgresql://postgres:postgres@localhost:5432/webpribadi?schema=public
# - Antar container (dipakai service "web" di compose) host-nya "db":
#   postgresql://postgres:postgres@db:5432/webpribadi?schema=public
# - Produksi (Neon/Supabase/Postgres sendiri): tempel connection string Anda.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webpribadi?schema=public"

# Kredensial yang dipakai container Postgres pada docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webpribadi
